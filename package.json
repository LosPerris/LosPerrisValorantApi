{
  "name": "losperris-valorant-api",
  "version": "1.0.0",
  "main": "api/index.js",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ponss17/LosPerrisValorantApi.git"
  },
  "keywords": [
    "valorant",
    "api",
    "twitch",
    "bot",
    "rank",
    "mmr",
    "nightbot",
    "streamelements"
  ],
  "author": "Ponss17",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ponss17/LosPerrisValorantApi/issues"
  },
  "homepage": "https://github.com/Ponss17/LosPerrisValorantApi#readme",
  "description": "API de Valorant para obtener rangos, historial y comandos para bots de Twitch.",
  "dependencies": {
    "@astrojs/react": "^5.0.6",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/vercel": "^10.0.8",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.2",
    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "lru-cache": "^10.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "core-js"
    ]
  }
}
