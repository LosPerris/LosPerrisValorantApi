{
  "name": "losperris-valorant-api",
  "version": "1.0.0",
  "main": "api/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "npx shx cp -r public dist/",
    "start": "node -r dotenv/config dist/api/index.js",
    "dev": "ts-node --files -r dotenv/config api/index.ts",
    "lint": "eslint src/**/*.ts api/**/*.ts",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ponss17/LosPerrisValorantApi.git"
  },
  "keywords": [
    "valorant",
    "api",
    "twitch",
    "bot",
    "rank",
    "mmr",
    "nightbot",
    "streamelements"
  ],
  "author": "Ponss17",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ponss17/LosPerrisValorantApi/issues"
  },
  "homepage": "https://github.com/Ponss17/LosPerrisValorantApi#readme",
  "description": "API de Valorant para obtener rangos, historial y comandos para bots de Twitch.",
  "dependencies": {
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "lru-cache": "^10.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "shx": "^0.4.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ]
  }
}
