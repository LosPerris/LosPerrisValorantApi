{
    "version": 2,
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "upgrade-insecure-requests; frame-ancestors 'self'"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/valorant/css/(.*)",
            "destination": "/css/$1"
        },
        {
            "source": "/api/valorant/js/(.*)",
            "destination": "/js/$1"
        },
        {
            "source": "/api/valorant/imgs/(.*)",
            "destination": "/imgs/$1"
        },
        {
            "source": "/api/valorant",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/api/valorant/(.*)",
            "destination": "/dist/api/index.js"
        }
    ],
    "cleanUrls": true
}