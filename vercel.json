{
    "version": 2,
    "headers": [
        {
            "source": "/js/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/css/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/imgs/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=604800, immutable"
                }
            ]
        },
        {
            "source": "/components/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://media.valorant-api.com; connect-src 'self' https://api.henrikdev.xyz https://valorant-api.com https://unpkg.com; object-src 'none'; upgrade-insecure-requests; frame-ancestors 'self'"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains; preload"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api/valorant/js/:path*",
            "destination": "/js/:path*"
        },
        {
            "source": "/api/valorant/css/:path*",
            "destination": "/css/:path*"
        },
        {
            "source": "/api/valorant/imgs/:path*",
            "destination": "/imgs/:path*"
        },
        {
            "source": "/api/valorant/components/:path*",
            "destination": "/components/:path*"
        },
        {
            "source": "/api/valorant/docs.html",
            "destination": "/docs.html"
        },
        {
            "source": "/api/valorant/overlay.html",
            "destination": "/overlay.html"
        },
        {
            "source": "/api/valorant/index.html",
            "destination": "/index.html"
        },
        {
            "source": "/product.html/riot.txt",
            "destination": "/riot.txt"
        },
        {
            "source": "/api/(.*)",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/rank/(.*)",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/match/(.*)",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/history/(.*)",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/summary/(.*)",
            "destination": "/dist/api/index.js"
        },
        {
            "source": "/preview/(.*)",
            "destination": "/dist/api/index.js"
        }
    ],
    "cleanUrls": false
}