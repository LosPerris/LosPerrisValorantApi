{
    "version": 2,
    "rewrites": [
        {
            "source": "/valorantapi",
            "destination": "/api/index.js"
        },
        {
            "source": "/valorantapi/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}