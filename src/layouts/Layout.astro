---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Valorant Rank, Match History and Streamer Bot Commands API. Check your stats and get commands for Nightbot, StreamElements and more." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/webp" href="/api/valorant/imgs/LosPerris-minimal.svg" />
		<meta name="theme-color" content="#ff4655" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
