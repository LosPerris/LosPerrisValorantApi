---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/islands/Footer';
import AboutApiModal from '../components/islands/AboutApiModal';
---

<Layout title="404 | LosPerris Valorant API">
  <a
    href="/"
    class="fixed top-4 left-4 md:left-8 flex items-center gap-2.5 z-50 bg-[#0a0a0d]/60 backdrop-blur-xl border border-white/5 pl-2 pr-4 py-1.5 rounded-full shadow-[0_4px_24px_rgba(0,0,0,0.5)] transition hover:bg-white/5"
  >
    <img
      src="/imgs/LosPerris-minimal.svg"
      alt="LosPerris"
      class="w-6 h-6 md:w-7 md:h-7 drop-shadow-[0_0_8px_rgba(255,70,85,0.6)]"
    />
    <span class="text-white font-extrabold tracking-tight text-xs md:text-sm hidden sm:inline">
      LOS<span class="text-[#ff4655]">PERRIS</span>
      <span class="font-bold text-white opacity-90">API</span>
    </span>
  </a>

  <div class="relative z-10 min-h-screen flex flex-col">
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-24 text-center">
      <p class="text-[#ff4655] text-sm font-bold tracking-widest uppercase mb-3">Error 404</p>
      <h1 class="text-4xl md:text-5xl font-bold text-white m-0 mb-4">Página no encontrada</h1>
      <p class="text-neutral-400 text-base max-w-md m-0 mb-8 leading-relaxed">
        La página que buscas no existe o ya no está disponible. Puedes volver al panel o consultar la
        documentación.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#ff4655] text-white font-semibold text-sm no-underline hover:opacity-90 transition-opacity"
        >
          Ir al panel
        </a>
        <a
          href="/docs"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/15 text-white font-semibold text-sm no-underline hover:bg-white/5 transition-colors"
        >
          Ver documentación
        </a>
      </div>
    </main>

    <AboutApiModal client:load />
    <Footer client:load />
  </div>
</Layout>
