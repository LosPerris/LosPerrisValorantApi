---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Footer from '../components/islands/Footer';
import AboutApiModal from '../components/islands/AboutApiModal';
---

<Layout title="404 | LosPerris Valorant API">
  <a
    href="/"
    class="fixed top-4 left-4 md:left-6 flex items-center gap-2.5 z-50 transition hover:opacity-80"
  >
    <img src="/imgs/LosPerris-minimal.svg" alt="LosPerris" class="w-6 h-6" />
    <span class="text-white font-extrabold tracking-tight text-sm hidden sm:inline">
      LOS<span class="text-[#ff4655]">PERRIS</span>
      <span class="font-bold text-white/80">API</span>
    </span>
  </a>

  <div class="fixed inset-0 pointer-events-none z-[-10] bg-[#050505]">
    <div
      class="absolute inset-0"
      style="
        background-image:
          linear-gradient(to right, rgba(0,0,0,0.8) 1px, transparent 1px),
          linear-gradient(to right, rgba(255,70,85,0.15) 2px, transparent 2px),
          linear-gradient(to bottom, rgba(0,0,0,0.8) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255,70,85,0.15) 2px, transparent 2px);
        background-size: 100px 100px;
        background-position: center center;
      "
    ></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#050505] via-transparent to-[#050505]"></div>
  </div>

  <div class="relative z-10 min-h-screen flex flex-col">
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-24 text-center">
      <p class="text-[12px] font-medium text-[#ff4655] mb-2">404</p>
      <h1 class="text-3xl md:text-4xl font-bold text-white m-0 mb-3 tracking-tight">Página no encontrada</h1>
      <p class="text-neutral-400 text-sm max-w-md m-0 mb-7 leading-relaxed">
        La página que buscas no existe o ya no está disponible.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="inline-flex items-center h-10 px-4 rounded-lg bg-[#ff4655] text-[#0a0a0a] font-semibold text-sm no-underline hover:bg-[#ff5c6a] transition-colors"
        >
          Ir al panel
        </a>
        <a
          href="/docs"
          class="inline-flex items-center h-10 px-4 rounded-lg border border-white/10 text-neutral-300 font-medium text-sm no-underline hover:text-white hover:border-white/20 transition-colors"
        >
          Documentación
        </a>
      </div>
    </main>

    <AboutApiModal client:idle />
    <Footer client:visible />
  </div>
</Layout>
